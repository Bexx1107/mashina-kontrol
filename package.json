{
  "name": "mashina-kontrol",
  "version": "2.1.0",
  "description": "Artisanal, ultra-low latency, zero-install virtual PC game controller, macro deck, trackpad & presentation remote by Mashina Studio.",
  "main": "electron/main.js",
  "bin": {
    "kontrol": "server/daemon.js"
  },
  "scripts": {
    "start": "node server/daemon.js",
    "electron": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win",
