{
  "appId": "com.mashinastudio.kontrol",
  "productName": "Mashina Kontrol",
  "copyright": "Copyright © 2026 Mashina Studio",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "server/daemon.js",
    "server/bin/kontrol-wininput.exe",
    "server/bin/Nefarius.ViGEm.Client.dll",
    "public/**/*",
    "drivers/**/*",
    "app.ico",
    "package.json",
    "!server/bin/vigem_pkg/**",
    "!server/src/**"
  ],
  "asarUnpack": [
    "server/bin/**/*",
    "drivers/**/*"
  ],
  "extraResources": [
    {
      "from": "server/bin",
      "to": "server/bin",
      "filter": [
        "kontrol-wininput.exe",
        "Nefarius.ViGEm.Client.dll",
        "kontrol-macinput"
      ]
    },
    {
      "from": "drivers",
      "to": "drivers",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "app.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Mashina Kontrol",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "icon": "public/icon-512.png",
    "category": "public.app-category.utilities",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
